{
  "manifest_version": 3,
  "name": "Perplexity Fork Map",
  "version": "1.0.0",
  "description": "View the fork relationships between Perplexity conversations.",
  "permissions": ["storage"],
  "host_permissions": ["https://www.perplexity.ai/*"],
  "content_scripts": [
    {
      "matches": ["https://www.perplexity.ai/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}